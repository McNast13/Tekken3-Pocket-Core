# H8/300H sizing model alone (docs/STUDY.md). Build: synth/h8_size/run.sh
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY h8_size
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_FILE h8_size.vhd
set_global_assignment -name SDC_FILE h8_size.sdc
set_global_assignment -name SEED 99
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_instance_assignment -name VIRTUAL_PIN ON -to ce
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to ucode_we
set_instance_assignment -name VIRTUAL_PIN ON -to ucode_sel
set_instance_assignment -name VIRTUAL_PIN ON -to bus_rd
set_instance_assignment -name VIRTUAL_PIN ON -to bus_wr
set_instance_assignment -name VIRTUAL_PIN ON -to bus_ready
set_instance_assignment -name VIRTUAL_PIN ON -to irq
set_instance_assignment -name VIRTUAL_PIN ON -to irq_ack
set_instance_assignment -name VIRTUAL_PIN ON -to "ucode_addr"
set_instance_assignment -name VIRTUAL_PIN ON -to "ucode_data"
set_instance_assignment -name VIRTUAL_PIN ON -to "bus_addr"
set_instance_assignment -name VIRTUAL_PIN ON -to "bus_dout"
set_instance_assignment -name VIRTUAL_PIN ON -to "bus_din"
set_instance_assignment -name VIRTUAL_PIN ON -to "bus_be"
set_instance_assignment -name VIRTUAL_PIN ON -to "irq_vec"

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.1 Lite Edition"