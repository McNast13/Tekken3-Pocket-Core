#!/usr/bin/env python3
"""Fit probe for the Tekken 3 study (docs/STUDY.md, fit gate): how much room does removing the C76's CPU give?
Replaces the M37702 core with a stub of the same ports. The stub is a 24-bit LFSR that mixes in bus_din, bus_ready and
the interrupt inputs and drives the bus outputs, so the C76 wrapper, the shared RAM and the C352 behind it stay live and
are not pruned (deleting the CPU outright would also prune the C352, ~2,100 ALMs, and overstate the room).
Not a working core: sound and the C76 side are dead. Measurement only.
Usage: fit_no_m37702.apply OUTDIR   (S11_PROBES, after pocket_emu.apply)
"""
import sys
from pathlib import Path

f = Path(sys.argv[1]) / "rtl/m37702.vhd"
t = f.read_text()
i = t.index("architecture arch of m37702 is")
f.write_text(t[:i] + """architecture stub of m37702 is
   signal lfsr : std_logic_vector(23 downto 0) := x"000001";
begin
   process (clk)
      variable fb : std_logic;
   begin
      if rising_edge(clk) then
         if reset = '1' then
            lfsr <= x"000001";
         elsif ce = '1' and bus_ready = '1' then
            fb := lfsr(23) xor lfsr(22) xor lfsr(21) xor lfsr(16) xor irq0 xor irq1 xor irq2 xor irq_tb0 xor irq_tb1
                  xor irq_ad xor irq_ta2 xor irq_ta3 xor bus_din(0) xor bus_din(3) xor bus_din(5) xor bus_din(7)
                  xor prio_int0(0) xor prio_tb0(0) xor prio_tb1(0) xor prio_ad(0);
            lfsr <= lfsr(22 downto 0) & fb;
            lfsr(8 downto 1) <= lfsr(7 downto 0) xor bus_din;
         end if;
      end if;
   end process;
   bus_addr   <= lfsr;
   bus_dout   <= lfsr(15 downto 8);
   bus_rd     <= lfsr(3);
   bus_wr     <= lfsr(4) and lfsr(9);
   dbg_pc     <= lfsr;
   dbg_opcode <= lfsr(7 downto 0);
   dbg_valid  <= lfsr(5);
   dbg_halted <= '0';
   dbg_x      <= lfsr(15 downto 0);
end architecture;
""")
print("fit_no_m37702 applied")
